{
  "schemaVersion": 1,
  "id": "rftoolsutility",
  "version": "${version}",
  "name": "RFToolsUtility",
  "description": "RFToolsUtility for Fabric",
  "authors": [
    "McJty"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mcjty.rftoolsutility.RFToolsUtility"
    ],
    "client": [
      "mcjty.rftoolsutility.setup.ClientSetup"
    ],
    "fabric-datagen": [
      "mcjty.rftoolsutility.datagen.FabricDataGen"
    ],
    "theoneprobe": [
      "mcjty.rftoolsutility.compat.TheOneProbeSupport"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.164.0+26.3",
    "forgeconfigapiport": ">=26.3.1",
    "mcjtylib": ">=26.3-11.0.5-fabric",
    "rftoolsbase": ">=26.3-9.0.2-fabric"
  },
  "suggests": {
    "theoneprobe": "*",
    "jei": "*"
  },
  "accessWidener": "rftoolsutility.accesswidener",
  "mixins": [
    "rftoolsutility.mixins.json"
  ]
}
